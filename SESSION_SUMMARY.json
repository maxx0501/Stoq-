  "key_improvements": [
    {
      "what": "Subscriptions API ao invés de Preferences",
      "why": "Melhor manejo de trial periods nativo do MercadoPago",
      "benefit": "Sem fake charges (R$ 0.01), profissional e seguro"
    },
    
    {
      "what": "Autenticação obrigatória no checkout",
      "why": "Precisa do email do usuário para criar preapproval",
      "benefit": "Menos rejeições, melhor tracking, segurança"
    },
    
    {
      "what": "Cancelamento sincronizado com MP",
      "why": "Evita cobranças futuras mesmo se falhar localmente",
      "benefit": "Experiência do usuário confiável, sem surpresas"
    },
    
    {
      "what": "Webhook para ambos eventos (preapproval_create + payment)",
      "why": "Ativar assinatura quando autoriza, renovar quando cobra",
      "benefit": "Ciclo de vida completo da assinatura"
    },
    
    {
      "what": "Interface de Settings para cancelamento",
      "why": "Usuários precisam de forma fácil de gerenciar assinatura",
      "benefit": "UX profissional, transparência"
    },
    
    {
      "what": "Console logs detalhados",
