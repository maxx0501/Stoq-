  "database_schema": {
    "store_model_fields": {
      "isSubscribed": {
        "type": "Boolean",
        "required": true,
        "default": false,
        "meaning": "Indica se usuário tem acesso ativo"
      },
      
      "mercadoPagoPreapprovalId": {
        "type": "String",
        "required": false,
        "default": null,
        "meaning": "ID da preapproval no MercadoPago"
      },
      
      "subscriptionExpiresAt": {
        "type": "DateTime",
        "required": false,
        "default": null,
        "meaning": "Data em que acesso expira"
      },
      
      "nextBillingDate": {
        "type": "DateTime",
        "required": false,
        "default": null,
        "meaning": "Próxima data de cobrança"
      }
    }
  },
  
  "migration_notes": {
    "from": "MercadoPago Preferences API (one-time payments with metadata)",
    "to": "MercadoPago Subscriptions API (Preapprovals with native trial)",
    
