  "files_modified": [
    {
      "path": "backend/src/lib/mercadopago.ts",
      "changes": "ADICIONADO: Suporte Subscriptions API",
      "details": {
        "what_added": [
          "Import de axios para requisições HTTP",
          "Objeto 'subscriptions' com 3 métodos",
          "createPreapproval(data) - POST /preapprovals",
          "getPreapproval(id) - GET /preapprovals/{id}",
          "cancelPreapproval(id) - PUT /preapprovals/{id}"
        ],
        "why": "MercadoPago SDK não suporta nativamente Subscriptions API, axios usado como fallback",
        "impact": "Backend agora pode gerenciar preapprovals (pré-autorizações) com trial nativo"
      }
    },
    
    {
      "path": "backend/src/routes/payments.routes.ts",
      "changes": "REFATORADO: 3 seções principais",
      "details": {
        "section_1": {
          "name": "POST /create-checkout",
          "changes": "Migrado de Preferences API para Subscriptions API",
          "before": "Aceitava qualquer request, criava preference com R$ 0.01",
          "after": "Requer authMiddleware, usa Preapprovals, start_date = +30 dias",
          "breaking_change": true,
          "requires_auth": true,
          "key_logic": "isFirstSubscription → start_date calcula automaticamente período de trial"
        },
        
        "section_2": {
          "name": "POST /webhook",
          "changes": "Suporte completo para preapproval_create e payment",
          "handles_events": [
            {
              "type": "preapproval_create",
              "triggers_when": "Usuário autoriza cartão no MP",
              "actions": "Busca detalhes, valida status=authorized, ativa isSubscribed",
              "database_updates": ["isSubscribed: true", "nextBillingDate", "mercadoPagoPreapprovalId"]
            },
            {
              "type": "payment",
              "triggers_when": "Cobrança automática executada",
              "actions": "Valida status=approved, recalcula próxima cobrança",
              "database_updates": ["nextBillingDate: +30 dias", "plan"]
            }
          ]
        },
        
        "section_3": {
          "name": "POST /cancel-subscription",
          "changes": "Adicionado authMiddleware e sincronização com MP",
          "before": "Apenas atualizava banco de dados",
          "after": "Chama subscriptions.cancelPreapproval() antes de atualizar banco",
          "now_requires_auth": true,
          "new_logic": "Cancela preapproval no MP (para cobranças futuras)"
        }
      }
    },
    
    {
      "path": "frontend/src/pages/Settings.tsx",
      "changes": "ADICIONADA: Nova aba 'Assinatura'",
      "details": {
        "new_tab": {
          "name": "subscription",
          "label": "Assinatura",
          "icon": "CreditCard",
          "position_in_menu": "Entre 'Dados da Loja' e 'Segurança'"
        },
        
        "ui_components": [
          {
            "name": "Status Card",
            "shows": "Estado da assinatura (Ativo/Cancelado)",
            "visual": "Azul com CheckCircle"
          },
          {
            "name": "Cancel Button",
            "shows_when": "user.isSubscribed === true",
            "action": "Abre modal de confirmação",
            "visual": "Vermelho na card de 'Zona de Perigo'"
          },
          {
            "name": "Cancel Confirmation Modal",
            "content": "Pergunta confirmação com info sobre acesso até fim período",
            "actions": ["Manter", "Cancelar"]
          }
        ],
        
        "new_function": {
          "name": "handleCancelSubscription()",
          "flow": [
            "POST /payments/cancel-subscription (com token)",
            "Backend cancela no MP",
            "Atualiza estado local user.isSubscribed = false",
            "Mostra modal de sucesso"
          ]
        }
      }
    },
    
