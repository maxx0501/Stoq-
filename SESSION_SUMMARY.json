    },
    
    "automatic_billing": {
      "day_31": "MP executa cobrança automática",
      "step_1": "MP envia webhook: payment",
      "step_2": "Backend valida status = approved",
      "step_3": "nextBillingDate = +30 dias",
      "step_4": "Cobranças continuam mensais"
    },
    
